# ddb (client node: ddb run, ddb listen, ddb node and the operator commands). Copy to ddb.env and
# chmod 600. Looked for as --env-file, ./ddb.env, ~/.config/ddb/ddb.env, /etc/ddb/ddb.env - a
# node may start ddb node / ddb listen from any directory, so ~/.config/ddb or /etc/ddb is the
# safe place. Variables already set in the environment override this file.

# This client node's REST app interface (host and port). Required: there is no default.
API_BASE_URL=http://<node-host>:5000/AppApi
API_TIMEOUT=10
MESSAGE_TTL=600

# Token minted on this client node for app ddb: reads and acks the one inbox every data source shares.
DDB_TOKEN=
# Token minted on this client node for app ddbs: sends commands to the servers' ddbs app. Newer DAPPS
# releases require it; leave empty on an older node that accepts outbound posts without a token.
DDBS_TOKEN=
# Enabled data sources, comma-separated (ddb sources lists them with their data set IDs). Each is
# described at the end of this file. For all of them:
# DDB_SOURCES=fc,kp,solar,aurora,quakes,tropo
DDB_SOURCES=fc
DDB_DB=ddb.sqlite3
POLL_INTERVAL=5

# User sessions
NODE_EOL=cr
NODE_IDLE_TIMEOUT=300
# ddb listen (G8BPQ, XRouter; it also does ddb run's work, so run one or the other): port, or
# host:port; no default
NODE_LISTEN=
NODE_MAX_SESSIONS=10

# --- Every data set (FC, KP, SOLAR, ...) ---
# These apply to each enabled data set. To set one for a single data set, use its name instead of DDB_,
# e.g. KP_SERVERS=GB7BBB-7 or FC_MAX_USER_SUBS=3; that wins over the DDB_ value for that data set alone.
# The servers' DAPPS callsigns (where ddbs and ddb-hub run, usually a node callsign with SSID -7),
# comma-separated, most preferred first. The node uses one at a time and fails over to the next if it goes quiet.
# The first server is GB7FCI-7, which serves every data set.
DDB_SERVERS=GB7FCI-7
# Seconds with no new data before pinging the active server (default 1.5 x the data set's validity,
# 9 h for forecasts); only for testing
# DDB_IDLE_PING=
# Subscriptions per user, per data set
DDB_MAX_USER_SUBS=5
DDB_RESEND_DELAY=600
# A one-off GET with no answer after this many seconds is dropped, and its users told
DDB_GET_TIMEOUT=3600
# Drop a user's subscription after this many days without them viewing it (SHOW); 0 = never
DDB_IDLE_UNSUB_DAYS=60
# The nightly LIST check goes at a random minute in this window (local time)
DDB_LIST_WINDOW_START=00:00
DDB_LIST_WINDOW_END=04:00

# --- The data sets ---
# Enable one by adding its name to DDB_SOURCES; it then uses the DDB_ settings above. The settings below
# are optional: uncomment one only to give that data set a value of its own, e.g. other servers.

# fc: weather forecasts by locator (data set 39052CE4), from the GFS model; enabled by default.
# Users: DDB, FC, then SUB IO83lt, GET IO83lt, SHOW.
# FC_SERVERS=GB7FCI-7
# FC_MAX_USER_SUBS=5
# FC_GET_TIMEOUT=3600
# FC_IDLE_PING=32400

# kp: the Kp index and NOAA's 3-day space-weather forecast (data set 9CD9E150), a broadcast
# every 3 hours. Users: DDB, KP, then SUB and SHOW.
# KP_SERVERS=GB7FCI-7
# KP_IDLE_PING=16200

# solar: solar flux, sunspots, flares, solar wind and estimated HF conditions (data set 5298346A),
# a broadcast every 3 hours. Users: DDB, SOLAR, then SUB and SHOW.
# SOLAR_SERVERS=GB7FCI-7
# SOLAR_IDLE_PING=16200

# aurora: the aurora chance by locator from NOAA's OVATION model (data set 9B6C3A71), every 3 hours.
# Users: DDB, AURORA, then SUB IO83lt or GET IO83lt, and SHOW.
# AURORA_SERVERS=GB7FCI-7
# AURORA_MAX_USER_SUBS=5
# AURORA_IDLE_PING=16200

# quakes: earthquakes of note by locator from EMSC (data set 4E7A2C19), every 3 hours.
# Users: DDB, QUAKES, then SUB IO83lt or GET IO83lt, and SHOW.
# QUAKES_SERVERS=GB7FCI-7
# QUAKES_MAX_USER_SUBS=5
# QUAKES_IDLE_PING=16200

# tropo: tropospheric ducting by locator from the GFS model (data set 36A5C17D), with each forecast run.
# Users: DDB, TROPO, then SUB IO83lt or GET IO83lt, and SHOW.
# TROPO_SERVERS=GB7FCI-7
# TROPO_MAX_USER_SUBS=5
# TROPO_IDLE_PING=32400
